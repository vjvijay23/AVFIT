# Google Maps Cloud API Key
AVFIT_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Supabase Configuration (Free Tier: https://supabase.com)
AVFIT_SUPABASE_URL=https://your-project-id.supabase.co
AVFIT_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (Free Tier: https://aistudio.google.com)
AVFIT_GEMINI_API_KEY=your-google-gemini-api-key

# AVFIT backend (defaults to the live Render service when omitted).
AVFIT_API_URL=https://avfit-api.onrender.com/api/v1

# MSG91 OTP widget-scoped client credentials. Web and mobile widgets may need
# separate IDs if Mobile Integration is enabled for the mobile widget. The
# account Authkey belongs only in backend/.env and Render.
AVFIT_OTP_PROVIDER=msg91
AVFIT_MSG91_WIDGET_ID=
AVFIT_MSG91_TOKEN_AUTH=
AVFIT_MSG91_WEB_WIDGET_ID=
AVFIT_MSG91_WEB_TOKEN_AUTH=
AVFIT_MSG91_MOBILE_WIDGET_ID=
AVFIT_MSG91_MOBILE_TOKEN_AUTH=
AVFIT_MSG91_OTP_LENGTH=6

# To use a local backend instead, uncomment and set your computer's LAN IP.
# Android emulator can use http://10.0.2.2:5000/api/v1.
# AVFIT_API_URL=http://192.168.1.20:5000/api/v1
