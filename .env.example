# Google Maps Cloud API Key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Supabase Configuration (Free Tier: https://supabase.com)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (Free Tier: https://aistudio.google.com)
EXPO_PUBLIC_GEMINI_API_KEY=your-google-gemini-api-key

# Optional override for a physical device; replace with your computer's LAN IP.
# Web/iOS simulator defaults to localhost; Android emulator defaults to 10.0.2.2.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:5000/api/v1
