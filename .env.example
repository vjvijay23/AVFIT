# Google Maps Cloud API Key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Supabase Configuration (Free Tier: https://supabase.com)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (Free Tier: https://aistudio.google.com)
EXPO_PUBLIC_GEMINI_API_KEY=your-google-gemini-api-key

# AVFIT backend (defaults to the live Render service when omitted).
EXPO_PUBLIC_API_URL=https://avfit-api.onrender.com/api/v1

# MSG91 mobile OTP. These are the widget-scoped client credentials shown in
# OTP Widget/SDK. The account Authkey belongs only in backend/.env and Render.
EXPO_PUBLIC_OTP_PROVIDER=msg91
EXPO_PUBLIC_MSG91_WIDGET_ID=
EXPO_PUBLIC_MSG91_TOKEN_AUTH=

# To use a local backend instead, uncomment and set your computer's LAN IP.
# Android emulator can use http://10.0.2.2:5000/api/v1.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:5000/api/v1
