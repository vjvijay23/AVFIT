<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>AVFIT</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
	  <!-- Do not change NSAllowsArbitraryLoads to true, or you will risk app rejection! -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>AVFIT uses your location to show your position and record routes while you track an activity.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>AVFIT uses location during an active workout so your route can continue to be recorded when the app is in the background.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>AVFIT uses location during an active workout so your route can continue to be recorded when the app is in the background.</string>
	<key>NSCameraUsageDescription</key>
	<string>AVFIT uses the camera so you can scan meals and share photos with the fitness community.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>AVFIT accesses selected photos so you can scan meals and share photos with the fitness community.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>AVFIT can save images you choose to export to your photo library.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>AVFIT uses Face ID only when you enable biometric sign-in.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>AVFIT reads your steps, walking distance, and active calories to show your daily activity from Apple Health and compatible apps.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>AVFIT saves workouts you choose to log so they can appear in Apple Health and compatible apps.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
