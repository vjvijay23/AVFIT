{
  "name": "avfit-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "AVFIT Fastify Backend with PostGIS Walking Analyzer, Gemini AI Vision & Redis Leaderboard",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "test:mock": "node --import tsx --test test/api.mock.test.ts test/vision.scanner.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@google/generative-ai": "^0.24.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pg": "^8.11.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
}
