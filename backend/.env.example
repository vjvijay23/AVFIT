NODE_ENV=development
PORT=5000
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5433/avfit_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-change-me
# MSG91 OTP Widget access-token verification. Keep the account Authkey server-side.
MSG91_AUTHKEY=
# Required for live food photo analysis and AI diet plan generation. Keep on backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_PRIMARY_TIMEOUT_MS=12000
GEMINI_FALLBACK_TIMEOUT_MS=9000
GEMINI_TOTAL_TIMEOUT_MS=22000
