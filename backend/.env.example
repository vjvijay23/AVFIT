NODE_ENV=development
PORT=5000
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5433/avfit_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-change-me
# Set to mock only for local development. Generates a temporary OTP and sends no SMS.
# Production startup refuses OTP_PROVIDER=mock.
OTP_PROVIDER=twilio
# Twilio Verify SMS credentials. Prefer an API key SID/secret from the same account and region.
# Alternatively use the Account SID/Auth Token pair. Never commit backend/.env.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
# Required for live food photo analysis and AI diet plan generation. Keep on backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
